# Your personal OpenAlex key: https://openalex.org/settings/api
OPENALEX_API_KEY=your-openalex-key
# Contact email sent to OpenAlex and publishers (polite-pool etiquette)
OPENALEX_CONTACT_EMAIL=uni1234@columbia.edu
# ID at the end of the shared folder URL: https://drive.google.com/drive/folders/<ID>
DRIVE_FOLDER_ID=your-drive-folder-id
# Google sign-in: set ONE of these (see README "Google Drive access").
# Local runs: the team's OAuth client file, so you sign in with your own Google account
GOOGLE_OAUTH_CLIENT_FILE=~/keys/steel_slag_oauth_client.json
# Unattended runs (GitHub Actions): a service account key
# GOOGLE_APPLICATION_CREDENTIALS=~/keys/steel_slag_service_account.json
# Google Cloud project for Vertex AI (Gemini) and the BigQuery paper registry.
# Locally, BigQuery uses your `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Unattended runs only: a service account key with BigQuery access in that project
# GCP_CREDENTIALS_FILE=~/keys/steel_slag_bigquery.json
